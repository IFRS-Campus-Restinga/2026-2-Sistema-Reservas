# Copie este arquivo pra ".env" dentro de /backend e preencha os valores.
# O ".env" nunca é commitado (já está no .gitignore), este arquivo de
# exemplo é o que fica versionado, só com os nomes das variáveis.

# Chave secreta do Django. Precisa ser EXATAMENTE a mesma
# SECRET_KEY configurada no .env do HUB (sistemas/backend/.env), é ela
# que assina/valida o JWT compartilhado entre os dois sistemas.
SECRET_KEY=

# Nomes dos cookies usados pelo HUB pra carregar o JWT (não costumam
# mudar — só preencha se o HUB estiver configurado com nomes diferentes
# dos padrões abaixo).
AUTH_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token

# Atributos do cookie de access_token que o backend gera quando
# renova o token expirado (RenovarTokenExpiradoMiddleware).
# iguais aos do HUB (sistemas/backend/.env).
AUTH_COOKIE_HTTPONLY=True
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax

# URL base do backend do HUB. Em dev local, com o HUB rodando via Dev
# Containers, é http://localhost:8000.
HUB_BASE_URL=http://localhost:8000

# api_key deste sistema (Reserva de Recursos) cadastrado no HUB.
# Obtida chamando POST /api/systems/create/
# cada pessoa/ambiente que rodar o HUB localmente vai gerar a sua própria.
HUB_SYSTEM_API_KEY=
